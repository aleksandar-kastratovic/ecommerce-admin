{
	"name": "croonus-ecommerce-fe-admin",
	"version": "1.0.0",
	"description": "Admin panel for e-commerce",
	"private": true,

	"docker": {
		"account": "65479696",
		"image": "ecommerce-admin"
	},

	"scripts": {
		"build": "react-scripts build",
		"start": "react-scripts start",

		"docker:prune": "docker system prune -a -f",
		"docker:build": "docker build . --build-arg EC_API_URL=$EC_API_URL -t $npm_package_docker_account/$npm_package_docker_image:latest",
		"docker:push": "docker push $npm_package_docker_account/$npm_package_docker_image:latest",
		"docker:run": "EC_DEV=$EC_DEV EC_SKIP_PULL=$EC_SKIP_PULL EC_PORT=$EC_PORT EC_DOCKER_USERNAME=$EC_DOCKER_USERNAME EC_DOCKER_PASSWORD=$EC_DOCKER_USERNAME ./deploy/run.sh"
	},
	"author": "Predrag Levic",
	"license": "ISC",
	"devDependencies": {
		"@babel/core": "^7.12.10",
		"@babel/preset-env": "^7.12.11",
		"@babel/preset-react": "^7.12.11",
		"babel-loader": "^8.2.2",
		"css-loader": "^5.0.1",
		"file-loader": "^6.2.0",
		"style-loader": "^1.0.1",
		"webpack": "^4.41.2",
		"webpack-cli": "^3.3.10"
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^1.2.36",
		"@fortawesome/free-regular-svg-icons": "^5.15.4",
		"@fortawesome/free-solid-svg-icons": "^5.15.4",
		"@fortawesome/react-fontawesome": "^0.1.16",
		"bootstrap": "^5.1.3",
		"deep-rename-keys": "^0.2.1",
		"popper.js": "^1.16.1",
		"react": "^17.0.2",
		"react-bootstrap": "^2.0.4",
		"react-bootstrap-table-next": "^4.0.3",
		"react-bootstrap-table2-paginator": "^2.1.2",
		"react-dom": "^17.0.2",
		"react-dropdown-tree-select": "^2.5.1",
		"react-easy-crop": "^4.0.2",
		"react-router-dom": "^6.2.1",
		"react-scripts": "5.0.0",
		"react-select": "^5.2.2",
		"react-sortable-tree": "^2.8.0",
		"react-toastify": "^8.1.0",
		"sass": "^1.45.1",
		"sass-loader": "^10.1.0"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
